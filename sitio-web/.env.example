# Copia este archivo a .env.local y llena los valores reales.
# NUNCA subas .env.local a git (ya está en .gitignore).

# --- Neon Postgres ---
# Panel de Neon > tu proyecto > Connection string (usa la de "pooled connection")
DATABASE_URL="postgresql://user:password@ep-xxxx.neon.tech/dbname?sslmode=require"

# --- Cloudflare R2 ---
# Panel de Cloudflare > R2 > Manage API Tokens
R2_ACCOUNT_ID="tu-account-id"
R2_ACCESS_KEY_ID="tu-access-key-id"
R2_SECRET_ACCESS_KEY="tu-secret-access-key"
R2_BUCKET_NAME="amparo-rozo-portafolio"
# URL pública del bucket (dominio propio conectado al bucket, o el dev URL de R2)
R2_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"

# --- Autenticación del panel de administración ---
# Generar con: npm run hash-password -- "tu-contraseña-elegida"
ADMIN_PASSWORD_HASH="salt-en-hex:hash-en-hex"
# Cadena aleatoria larga (32+ caracteres) para firmar/cifrar la sesión. Generar con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="reemplaza-con-una-cadena-aleatoria-larga"

# --- WhatsApp ---
# Número en formato internacional sin signos, ej: 573133631715
NEXT_PUBLIC_WHATSAPP_NUMBER="573133631715"

# --- SEO ---
# Dominio de producción (sin slash final). Se usa para metadataBase, canonical,
# sitemap.xml, robots.txt y las imágenes Open Graph. Sin esta variable, cae al
# dominio de Vercel del despliegue o a localhost en desarrollo.
NEXT_PUBLIC_SITE_URL="https://www.correcionestilo.com"
