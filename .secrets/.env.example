# ============================================================================
# CREDENCIALES DEL ENTORNO PARA WEB-CORRECTORA (secrets) - VERSIÓN EJEMPLO
# ============================================================================
# Este archivo es una plantilla. COPIA este archivo a .env y llena los valores reales.
# Nunca subas .env (ni .env.r2) a git. Usa GitHub Secrets o un gestor de secrets.

# --- Cloudflare R2 (almacenamiento de imágenes) ---
R2_ACCOUNT_ID="TU_ACCOUNT_ID"
R2_ACCESS_KEY_ID="TU_ACCESS_KEY_ID"
R2_SECRET_ACCESS_KEY="TU_SECRET_ACCESS_KEY"
R2_BUCKET_NAME="correccionestilo"
R2_PUBLIC_URL="https://pub-TU_ID.r2.dev"

# --- Base de datos (Neon Postgres) ---
DATABASE_URL="postgresql://TU_USR:CONTRASEÑA@ep-xxx.neon.tech/neondb?sslmode=require"

# --- Autenticación del panel (usuario: Amparo) ---
ADMIN_PASSWORD_HASH="salt-en-hex:hash-en-hex"
SESSION_SECRET="43e214e65339544fb3c759aec9db017dcfca223e64c7c29f53ac53d6b28a4b12"

# --- WhatsApp (envío de mensajes) ---
NEXT_PUBLIC_WHATSAPP_NUMBER="573133631715"

# --- SEO (meta canónica) ---
NEXT_PUBLIC_SITE_URL="https://www.correcionestilo.com"
